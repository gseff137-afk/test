#pragma comment(lib, "ntdll.lib")
#pragma comment(lib, "kernel32.lib")
#pragma comment(lib, "user32.lib")

#define _(str) skCrypt(str)

struct PlayerData {
    Vector3 position;
    float health;
    std::string name;
    int team;
    int flags;
    uintptr_t address;
};

struct CameraData {
    Matrix4x4 viewMatrix;
    uintptr_t cameraAddress;
};

struct PipePacket {
    uint32_t magic;
    uint32_t playerCount;
    uint32_t packetId;
    uint32_t checksum;
    uint8_t encryptedData[65536];
};

class RenderPipe {
private:
    HANDLE hPipe = INVALID_HANDLE_VALUE;
    std::string pipeName;
    uint8_t xorKey[32];
    uint32_t packetCounter = 0;
    std::chrono::steady_clock::time_point lastRecreateTime;
    std::chrono::steady_clock::time_point lastEmptyPacketTime;

    void GeneratePipeName() {
        crypter::DeadCodeGenerator::Dummy1();
        const char* prefix = _("\\\\.\\pipe\\");
        char randomPart[17];
        const char* chars = _("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789");
        for (int i = 0; i < 16; i++) {
            randomPart[i] = chars[skc::FastRandom() % 36];
        }
        randomPart[16] = 0;
        pipeName = std::string(prefix) + randomPart;
        crypter::DeadCodeGenerator::Dummy2();
    }

    void GenerateXorKey() {
        crypter::DeadCodeGenerator::Dummy3();
        HCRYPTPROV hProv = 0;
        DECLARE_API(BOOL, CryptAcquireContextW, HCRYPTPROV*, LPCWSTR, LPCWSTR, DWORD, DWORD);
        DECLARE_API(BOOL, CryptGenRandom, HCRYPTPROV, DWORD, BYTE*);
        DECLARE_API(BOOL, CryptReleaseContext, HCRYPTPROV, DWORD);
        
        if (pCryptAcquireContextW && pCryptGenRandom && pCryptReleaseContext) {
            if (pCryptAcquireContextW(&hProv, nullptr, nullptr, PROV_RSA_FULL, CRYPT_VERIFYCONTEXT)) {
                pCryptGenRandom(hProv, 32, xorKey);
                pCryptReleaseContext(hProv, 0);
                return;
            }
        }
        for (int i = 0; i < 32; i++) {
            xorKey[i] = (uint8_t)(skc::FastRandom() & 0xFF);
        }
        crypter::DeadCodeGenerator::Dummy1();
    }

    void EncryptData(uint8_t* data, size_t size) {
        for (size_t i = 0; i < size; i++) {
            data[i] ^= xorKey[i % 32];
        }
    }

    void DecryptData(uint8_t* data, size_t size) {
        for (size_t i = 0; i < size; i++) {
            data[i] ^= xorKey[i % 32];
        }
    }

    uint32_t CalculateChecksum(const uint8_t* data, size_t size) {
        uint32_t crc = 0xFFFFFFFF;
        for (size_t i = 0; i < size; i++) {
            crc ^= data[i];
            for (int j = 0; j < 8; j++) {
                crc = (crc >> 1) ^ ((crc & 1) ? 0xEDB88320 : 0);
            }
        }
        return ~crc;
    }

    void Close() {
        if (hPipe != INVALID_HANDLE_VALUE) {
            DECLARE_API(BOOL, DisconnectNamedPipe, HANDLE);
            DECLARE_API(BOOL, CloseHandle, HANDLE);
            if (pDisconnectNamedPipe) pDisconnectNamedPipe(hPipe);
            if (pCloseHandle) pCloseHandle(hPipe);
            hPipe = INVALID_HANDLE_VALUE;
        }
    }

public:
    RenderPipe() {
        lastRecreateTime = std::chrono::steady_clock::now();
        lastEmptyPacketTime = std::chrono::steady_clock::now();
    }

    bool Initialize() {
        crypter::DeadCodeGenerator::Dummy2();
        Close();
        GeneratePipeName();
        GenerateXorKey();
        
        DECLARE_API(HANDLE, CreateNamedPipeA, LPCSTR, DWORD, DWORD, DWORD, DWORD, DWORD, DWORD, LPSECURITY_ATTRIBUTES);
        
        if (!pCreateNamedPipeA) return false;
        
        hPipe = pCreateNamedPipeA(
            pipeName.c_str(),
            PIPE_ACCESS_DUPLEX,
            PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_WAIT,
            1,
            65536,
            65536,
            0,
            nullptr
        );
        
        if (hPipe == INVALID_HANDLE_VALUE) return false;
        
        DECLARE_API(BOOL, ConnectNamedPipe, HANDLE, LPOVERLAPPED);
        if (pConnectNamedPipe) {
            pConnectNamedPipe(hPipe, nullptr);
        }
        
        lastRecreateTime = std::chrono::steady_clock::now();
        return true;
    }

    void CheckRecreate() {
        auto now = std::chrono::steady_clock::now();
        auto elapsed = std::chrono::duration_cast<std::chrono::minutes>(now - lastRecreateTime).count();
        int recreateInterval = 15 + (skc::FastRandom() % 16);
        if (elapsed >= recreateInterval) {
            Initialize();
        }
    }

    bool SendPlayers(const std::vector<PlayerData>& players, const CameraData& camera) {
        crypter::DeadCodeGenerator::Dummy3();
        CheckRecreate();

        auto now = std::chrono::steady_clock::now();

        if (players.empty()) {
            auto elapsedSec = std::chrono::duration_cast<std::chrono::seconds>(now - lastEmptyPacketTime).count();
            int emptyInterval = 5 + (skc::FastRandom() % 6);
            if (elapsedSec < emptyInterval) {
                return true;
            }
            lastEmptyPacketTime = now;
        }

        size_t totalSize = sizeof(uint32_t) * 4 + sizeof(CameraData);
        for (const auto& p : players) {
            totalSize += sizeof(Vector3) + sizeof(float) + sizeof(int) * 2 + sizeof(uint32_t) + p.name.length() + 1;
        }
        
        std::vector<uint8_t> buffer(totalSize);
        uint8_t* ptr = buffer.data();
        
        uint32_t playerCount = (uint32_t)players.size();
        memcpy(ptr, &playerCount, sizeof(uint32_t)); ptr += sizeof(uint32_t);
        memcpy(ptr, &packetCounter, sizeof(uint32_t)); ptr += sizeof(uint32_t);
        
        uint32_t cameraSize = sizeof(CameraData);
        memcpy(ptr, &cameraSize, sizeof(uint32_t)); ptr += sizeof(uint32_t);
        memcpy(ptr, &camera, sizeof(CameraData)); ptr += sizeof(CameraData);
        
        for (const auto& p : players) {
            memcpy(ptr, &p.position, sizeof(Vector3)); ptr += sizeof(Vector3);
            memcpy(ptr, &p.health, sizeof(float)); ptr += sizeof(float);
            memcpy(ptr, &p.team, sizeof(int)); ptr += sizeof(int);
            memcpy(ptr, &p.flags, sizeof(int)); ptr += sizeof(int);
            uint32_t nameLen = (uint32_t)p.name.length() + 1;
            memcpy(ptr, &nameLen, sizeof(uint32_t)); ptr += sizeof(uint32_t);
            memcpy(ptr, p.name.c_str(), nameLen); ptr += nameLen;
        }
        
        uint32_t checksum = CalculateChecksum(buffer.data(), buffer.size());
        memcpy(buffer.data() + sizeof(uint32_t) * 2, &checksum, sizeof(uint32_t));
        
        EncryptData(buffer.data(), buffer.size());
        
        DWORD bytesWritten = 0;
        DECLARE_API(BOOL, WriteFile, HANDLE, LPCVOID, DWORD, LPDWORD, LPOVERLAPPED);
        if (!pWriteFile) return false;
        
        BOOL result = pWriteFile(hPipe, buffer.data(), (DWORD)buffer.size(), &bytesWritten, nullptr);
        
        packetCounter++;
        
        return result == TRUE;
    }

    ~RenderPipe() {
        Close();
    }
};

class DiscordRenderer {
private:
    DriverManager driver;
    RenderPipe pipe;
    bool initialized = false;
    uintptr_t gameBase = 0;
    HANDLE gameProcessHandle = nullptr;

    std::mutex dataMutex;
    std::vector<PlayerData> sharedPlayers;
    CameraData sharedCamera;

    uintptr_t GetGameBase() {
        crypter::DeadCodeGenerator::Dummy1();
        std::wstring gameAsm = L"GameAssembly.dll";
        return driver.get_module_base(0, gameAsm.c_str());
    }

    bool FindGameProcess() {
        crypter::DeadCodeGenerator::Dummy2();
        DECLARE_API(HANDLE, CreateToolhelp32Snapshot, DWORD, DWORD);
        DECLARE_API(BOOL, Process32FirstW, HANDLE, LPPROCESSENTRY32W);
        DECLARE_API(BOOL, Process32NextW, HANDLE, LPPROCESSENTRY32W);
        DECLARE_API(BOOL, CloseHandle, HANDLE);
        
        if (!pCreateToolhelp32Snapshot || !pProcess32FirstW || !pProcess32NextW || !pCloseHandle) return false;
        
        HANDLE snapshot = pCreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
        if (snapshot == INVALID_HANDLE_VALUE) return false;
        
        PROCESSENTRY32W pe = { sizeof(PROCESSENTRY32W) };
        DWORD pid = 0;
        
        if (pProcess32FirstW(snapshot, &pe)) {
            do {
                if (wcscmp(pe.szExeFile, L"RustClient.exe") == 0) {
                    pid = pe.th32ProcessID;
                    break;
                }
            } while (pProcess32NextW(snapshot, &pe));
        }
        
        pCloseHandle(snapshot);
        
        if (pid == 0) return false;
        
        DECLARE_API(HANDLE, OpenProcess, DWORD, BOOL, DWORD);
        if (!pOpenProcess) return false;
        
        gameProcessHandle = pOpenProcess(PROCESS_ALL_ACCESS, FALSE, pid);
        return gameProcessHandle != nullptr;
    }

    bool ReadGameData(std::vector<PlayerData>& players, CameraData& camera) {
        crypter::DeadCodeGenerator::Dummy3();
        
        if (!driver.is_driver_alive()) {
            if (!driver.startup()) return false;
        }
        
        if (gameBase == 0) {
            gameBase = GetGameBase();
            if (gameBase == 0) return false;
        }
        
        uintptr_t camAddr = gameBase + MainCamera_Class;
        if (!driver.safe_read_virtual(0, camAddr, camera.cameraAddress)) return false;
        
        uintptr_t viewMatrixAddr = camera.cameraAddress + VIEWMATRIX;
        if (!driver.safe_read_virtual(0, viewMatrixAddr, camera.viewMatrix)) return false;
        
        uintptr_t baseNetworkableAddr = gameBase + BaseNetworkable_Class;
        uintptr_t baseNetworkableClass = 0;
        if (!driver.safe_read_virtual(0, baseNetworkableAddr, baseNetworkableClass)) return false;
        
        uintptr_t staticFields = 0;
        if (!driver.safe_read_virtual(0, baseNetworkableClass + STATICFIELD, staticFields)) return false;
        
        uintptr_t clientEntitiesPtr = 0;
        if (!driver.safe_read_virtual(0, staticFields + CLIENTENTITIES, clientEntitiesPtr)) return false;
        
        uintptr_t clientEntities = Decryption::DecryptClientEntities(clientEntitiesPtr);
        if (!clientEntities) return false;
        
        uintptr_t entityRealm = 0;
        if (!driver.safe_read_virtual(0, clientEntities + ENTITYLIST, entityRealm)) return false;
        
        uintptr_t entityList = Decryption::DecryptEntityList(entityRealm);
        if (!entityList) return false;
        
        uintptr_t bufferList = 0;
        if (!driver.safe_read_virtual(0, entityList + BUFFERLIST, bufferList)) return false;
        
        uint32_t entityCount = 0;
        if (!driver.safe_read_virtual(0, bufferList + COUNT, entityCount)) return false;
        
        uintptr_t entityArray = 0;
        if (!driver.safe_read_virtual(0, bufferList + LIST, entityArray)) return false;
        
        std::vector<uint32_t> indices;
        for (uint32_t i = 0; i < entityCount && i < 100; i++) {
            indices.push_back(i);
        }

        std::random_device rd;
        std::mt19937 g(rd());
        std::shuffle(indices.begin(), indices.end(), g);
        
        players.clear();
        
        int readCounter = 0;

        for (uint32_t i : indices) {
            uintptr_t entitySlot = entityArray + FIRSTELEMENT + (i * 8);
            uintptr_t entity = 0;
            if (!driver.safe_read_virtual(0, entitySlot, entity)) continue;
            if (!entity) continue;
            
            uint32_t prefabID = 0;
            if (!driver.safe_read_virtual(0, entity + prefabIDs, prefabID)) continue;
            
            if (prefabID != 4108440852ULL) continue;
            
            PlayerData player;
            player.address = entity;
            
            Vector3 pos = {0,0,0};
            driver.safe_read_virtual(0, entity + POSITION, pos);
            player.position = pos;
            
            driver.safe_read_virtual(0, entity + HEALTH, player.health);
            
            uintptr_t namePtr = 0;
            driver.safe_read_virtual(0, entity + DISPLAYNAME, namePtr);
            if (namePtr) {
                wchar_t wideName[64] = {0};
                driver.safe_read_virtual(0, namePtr + 0x14, wideName);
                char narrowName[128] = {0};
                DECLARE_API(int, WideCharToMultiByte, UINT, DWORD, LPCWCH, int, LPSTR, int, LPCCH, LPBOOL);
                if (pWideCharToMultiByte) {
                    pWideCharToMultiByte(CP_UTF8, 0, wideName, -1, narrowName, 128, nullptr, nullptr);
                }
                player.name = narrowName;
            }
            
            driver.safe_read_virtual(0, entity + CURRENTTEAM, player.team);
            driver.safe_read_virtual(0, entity + PLAYERFLAGS, player.flags);
            
            if (player.health > 0 && player.health < 1000) {
                players.push_back(player);
            }

            readCounter++;
            int maxReads = 3 + (skc::FastRandom() % 3);
            if (readCounter >= maxReads) {
                DECLARE_API(void, Sleep, DWORD);
                int sleepTime = 5 + (skc::FastRandom() % 6);
                if (pSleep) pSleep(sleepTime);
                else Sleep(sleepTime);
                readCounter = 0;
            }
        }
        
        return true;
    }

    void DataThread() {
        int failCount = 0;
        auto lastPauseTime = std::chrono::steady_clock::now();

        DECLARE_API(void, Sleep, DWORD);
        int initialDelay = 1000 + (skc::FastRandom() % 2001);
        if (pSleep) pSleep(initialDelay);
        else Sleep(initialDelay);

        while (initialized) {
            auto now = std::chrono::steady_clock::now();
            auto elapsedSec = std::chrono::duration_cast<std::chrono::seconds>(now - lastPauseTime).count();
            int pauseInterval = 10 + (skc::FastRandom() % 11);

            if (elapsedSec >= pauseInterval) {
                int longPause = 500 + (skc::FastRandom() % 1501);
                if (pSleep) pSleep(longPause);
                else Sleep(longPause);
                lastPauseTime = std::chrono::steady_clock::now();
            }

            std::vector<PlayerData> tempPlayers;
            CameraData tempCamera;

            if (ReadGameData(tempPlayers, tempCamera)) {
                std::lock_guard<std::mutex> lock(dataMutex);
                sharedPlayers = tempPlayers;
                sharedCamera = tempCamera;
                failCount = 0;
            } else {
                failCount++;
                if (failCount > 10) {
                    driver.startup();
                    gameBase = GetGameBase();
                    failCount = 0;
                }
            }

            int baseDelay = 10 + (skc::FastRandom() % 26);
            if (pSleep) pSleep(baseDelay);
            else Sleep(baseDelay);
        }
    }

public:
    bool Initialize() {
        crypter::DeadCodeGenerator::Dummy1();
        
        DECLARE_API(void, Sleep, DWORD);
        if (pSleep) pSleep(500);
        else Sleep(500);
        
        if (!driver.startup()) return false;
        if (!FindGameProcess()) return false;
        
        gameBase = GetGameBase();
        if (gameBase == 0) return false;
        
        if (!pipe.Initialize()) return false;
        
        initialized = true;
        return true;
    }

    void Run() {
        if (!initialized) return;

        std::thread dataFetcher(&DiscordRenderer::DataThread, this);
        dataFetcher.detach();
        
        while (initialized) {
            crypter::DeadCodeGenerator::Dummy2();
            
            std::vector<PlayerData> playersToSend;
            CameraData cameraToSend;

            {
                std::lock_guard<std::mutex> lock(dataMutex);
                playersToSend = sharedPlayers;
                cameraToSend = sharedCamera;
            }
            
            pipe.SendPlayers(playersToSend, cameraToSend);
            
            int baseDelay = 10 + (skc::FastRandom() % 26);
            DECLARE_API(void, Sleep, DWORD);
            if (pSleep) pSleep(baseDelay);
            else Sleep(baseDelay);
        }
    }
};

static DiscordRenderer* g_Renderer = nullptr;

DWORD WINAPI MainThread(LPVOID lpParam) {
    crypter::DeadCodeGenerator::Dummy1();
    
    g_Renderer = new DiscordRenderer();
    
    if (g_Renderer->Initialize()) {
        g_Renderer->Run();
    }
    
    delete g_Renderer;
    g_Renderer = nullptr;
    
    return 0;
}

BOOL APIENTRY DllMain(HMODULE hModule, DWORD reason, LPVOID lpReserved) {
    if (reason == DLL_PROCESS_ATTACH) {
        crypter::DeadCodeGenerator::Dummy1();
        DisableThreadLibraryCalls(hModule);
        HANDLE hThread = CreateThread(nullptr, 0, MainThread, nullptr, 0, nullptr);
        if (hThread) CloseHandle(hThread);
        crypter::DeadCodeGenerator::Dummy2();
    }
    return TRUE;
}